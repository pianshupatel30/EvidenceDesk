# Runs with excerpts and lexical search immediately, without keys or downloads.
ED_PROVIDER=extractive
ED_VECTOR_BACKEND=tfidf
ED_RERANKER=coverage
ED_MIN_SIMILARITY=0.16
ED_MIN_COVERAGE=0.45

# Optional local generation. Install Ollama and pull the chosen model first.
ED_OLLAMA_URL=http://localhost:11434
ED_OLLAMA_MODEL=qwen2.5:3b

# Optional semantic retrieval. Install requirements-semantic.txt first.
ED_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ED_CROSS_ENCODER=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional cloud generation. Set ED_PROVIDER=openai-compatible and supply all values.
ED_API_BASE=https://api.openai.com/v1
ED_API_KEY=
ED_MODEL=
# USD per 1 million tokens from your provider's current rate card.
# Leave empty to report unknown cost. Zero is an explicitly configured free rate.
ED_INPUT_PRICE=
ED_OUTPUT_PRICE=
